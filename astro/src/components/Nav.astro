---
import Logo from './Logo.astro';

interface Props {
  /** Current page path so the right link gets aria-current="page". */
  pathname?: string;
}
const { pathname = Astro.url.pathname } = Astro.props;

// Normalise so '/' and '/index' both match the home link, and trailing slashes
// don't cause false-misses on /platform/ vs /platform.
const normalise = (p: string) => (p === '' ? '/' : p.replace(/\/$/, '') || '/');
const here = normalise(pathname);

const isCurrent = (href: string) => normalise(href) === here;

const roleLinks = [
  { href: '/cytidel-for-vulnerability-management', label: 'For Vulnerability Management' },
  { href: '/cytidel-for-threat-intelligence', label: 'For Threat Intelligence' },
  { href: '/cytidel-for-cisos', label: 'For CISOs' },
  { href: '/cytidel-for-analysts', label: 'For Analysts' },
];
const inRoles = roleLinks.some((l) => isCurrent(l.href));
---
<header class="nav sticky top-0 z-50 bg-[rgba(241,241,236,0.78)] backdrop-blur-md backdrop-saturate-[180%] border-b border-transparent transition-colors duration-200" id="nav">
  <div class="mx-auto max-w-page px-5 sm:px-6 md:px-8 lg:px-12 flex items-center justify-between h-[68px]">
    <a href="/" class="inline-flex items-center gap-2 text-text font-display font-semibold text-[1.15rem] tracking-tight" aria-label="Cytidel home">
      <Logo height={34} />
    </a>

    <nav class="nav-links flex items-center gap-[clamp(14px,2.4vw,28px)]" id="nav-links-menu" aria-label="Primary">
      <a href="/cytidel-platform" class:list={['nav-link', isCurrent('/cytidel-platform') && 'is-current']} aria-current={isCurrent('/cytidel-platform') ? 'page' : undefined}>Platform</a>
      <a href="/why-cytidel" class:list={['nav-link', isCurrent('/why-cytidel') && 'is-current']} aria-current={isCurrent('/why-cytidel') ? 'page' : undefined}>Why Cytidel</a>

      <div class="nav-dropdown relative" data-dropdown>
        <button
          class:list={['nav-dropdown-trigger inline-flex items-center gap-1.5 text-text-secondary hover:text-text font-medium text-[0.92rem] py-1 cursor-pointer relative transition-colors', inRoles && 'is-current']}
          type="button"
          aria-expanded="false"
          aria-haspopup="true"
          aria-controls="role-menu"
          data-active={inRoles ? 'true' : undefined}
        >
          For your role
          <svg class="caret transition-transform duration-200" width="10" height="6" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="nav-dropdown-menu" id="role-menu" role="menu">
          {roleLinks.map((l) => (
            <a href={l.href} role="menuitem" aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>
          ))}
        </div>
      </div>

      <a href="https://blog.cytidel.com" target="_blank" rel="noopener" class="nav-link">Blog</a>
      <a href="/careers" class:list={['nav-link', isCurrent('/careers') && 'is-current']} aria-current={isCurrent('/careers') ? 'page' : undefined}>Careers</a>
      <a href="/book-a-demo" class="nav-cta bg-accent text-[#0b2000] rounded-lg px-6 py-[14px] font-semibold text-[0.9rem] whitespace-nowrap shrink-0 transition-all duration-200 hover:-translate-y-px hover:shadow-[0_8px_22px_rgba(128,252,19,0.35)]" data-analytics="CTA|Book a Demo|Nav">Book a Demo</a>
    </nav>

    <button class="nav-burger hidden" type="button" aria-expanded="false" aria-controls="nav-links-menu" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<style>
  /* Underline-on-current for primary nav links and dropdown trigger.
     Tailwind utilities cover the rest of the nav; this is for the precise
     accent-deep underline that conditional ::after needs. */
  .nav-link {
    color: var(--color-text-secondary);
    font-size: 0.92rem;
    font-weight: 500;
    padding: 4px 0;
    position: relative;
    transition: color 0.15s ease;
  }
  .nav-link:hover { color: var(--color-text); }
  .nav-link.is-current { color: var(--color-text); }
  .nav-link.is-current::after,
  .nav-dropdown-trigger.is-current::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    background: var(--color-accent);
    border-radius: 2px;
  }
  .nav-dropdown-trigger.is-current::after { right: 16px; }

  .nav.scrolled { border-bottom-color: var(--color-border); }

  .nav-dropdown-trigger { background: transparent; border: 0; font: inherit; }
  .nav-dropdown-trigger:hover,
  .nav-dropdown-trigger[aria-expanded='true'] { color: var(--color-text); }
  .nav-dropdown-trigger[aria-expanded='true'] .caret { transform: rotate(180deg); }
  .nav-dropdown:hover > .nav-dropdown-trigger .caret,
  .nav-dropdown:focus-within > .nav-dropdown-trigger .caret { transform: rotate(180deg); }

  .nav-dropdown-menu {
    position: absolute;
    top: calc(100% + 12px);
    right: 0;
    min-width: 280px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 8px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    box-shadow: 0 20px 50px rgba(0,0,0,0.5);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s;
    z-index: 60;
  }
  .nav-dropdown:hover .nav-dropdown-menu,
  .nav-dropdown:focus-within .nav-dropdown-menu,
  .nav-dropdown-trigger[aria-expanded='true'] + .nav-dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .nav-dropdown-menu a {
    display: block;
    padding: 11px 14px;
    border-radius: 6px;
    color: var(--color-text-secondary);
    font-size: 0.92rem;
    font-weight: 500;
    white-space: nowrap;
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .nav-dropdown-menu a:hover { background: var(--color-surface-2); color: var(--color-text); }
  .nav-dropdown-menu a[aria-current='page'] { color: var(--color-accent-deep); background: var(--color-accent-dim); }

  /* Mobile burger */
  .nav-burger {
    background: transparent;
    border: 0;
    padding: 0;
    width: 44px;
    height: 44px;
    cursor: pointer;
    position: relative;
    flex-shrink: 0;
  }
  .nav-burger span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--color-text);
    border-radius: 2px;
    margin: 4px auto;
    transition: transform 0.25s ease, opacity 0.2s ease;
  }
  .nav-burger[aria-expanded='true'] span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .nav-burger[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .nav-burger[aria-expanded='true'] span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  @media (max-width: 820px) {
    .nav-burger { display: block; }
    .nav { backdrop-filter: none; }
    .nav-links {
      position: fixed;
      top: 68px;
      left: 0;
      right: 0;
      bottom: 0;
      background: var(--color-bg);
      flex-direction: column;
      align-items: stretch;
      padding: 16px clamp(20px, 4vw, 48px) 32px;
      gap: 0;
      overflow-y: auto;
      transform: translateY(-110%);
      visibility: hidden;
      transition: transform 0.25s ease, visibility 0.25s;
      z-index: 60;
    }
    .nav[data-mobile-open='true'] .nav-links {
      transform: translateY(0);
      visibility: visible;
    }
    .nav-links > a:not(.nav-cta) {
      display: block;
      width: 100%;
      padding: 18px 0;
      font-size: 1.05rem;
      border-bottom: 1px solid var(--color-border);
    }
    .nav-links > a.is-current::after { display: none; }
    .nav-dropdown { width: 100%; }
    .nav-dropdown-trigger {
      width: 100%;
      justify-content: space-between;
      padding: 18px 0;
      font-size: 1.05rem;
      border-bottom: 1px solid var(--color-border);
    }
    .nav-dropdown-menu {
      position: static;
      opacity: 1;
      visibility: visible;
      transform: none;
      box-shadow: none;
      background: transparent;
      border: 0;
      padding: 8px 16px 16px;
      min-width: 0;
    }
    .nav-dropdown-menu a {
      padding: 12px 0;
      font-size: 0.98rem;
    }
    .nav-cta {
      margin-top: 24px;
      align-self: flex-start;
      padding: 14px 26px;
    }
    :global(body.nav-locked) { overflow: hidden; }
  }
</style>

<script>
  // Subtle border-bottom on scroll
  const nav = document.getElementById('nav');
  if (nav) {
    const onScroll = () => {
      if (window.scrollY > 8) nav.classList.add('scrolled');
      else nav.classList.remove('scrolled');
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  // Dropdown — hover on desktop, click/keyboard on all
  document.querySelectorAll<HTMLElement>('[data-dropdown]').forEach((dd) => {
    const trigger = dd.querySelector<HTMLButtonElement>('.nav-dropdown-trigger');
    const menu = dd.querySelector<HTMLElement>('.nav-dropdown-menu');
    if (!trigger || !menu) return;
    const items = Array.from(menu.querySelectorAll<HTMLAnchorElement>('a'));

    const open = () => trigger.setAttribute('aria-expanded', 'true');
    const close = () => trigger.setAttribute('aria-expanded', 'false');
    const toggle = () => (trigger.getAttribute('aria-expanded') === 'true' ? close() : open());

    trigger.addEventListener('click', (e) => { e.stopPropagation(); toggle(); });
    trigger.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' || e.key === 'Enter' || e.key === ' ') {
        e.preventDefault(); open(); items[0]?.focus();
      } else if (e.key === 'Escape') {
        close();
      }
    });
    menu.addEventListener('keydown', (e) => {
      const idx = items.indexOf(document.activeElement as HTMLAnchorElement);
      if (e.key === 'ArrowDown')      { e.preventDefault(); items[(idx + 1) % items.length].focus(); }
      else if (e.key === 'ArrowUp')   { e.preventDefault(); items[(idx - 1 + items.length) % items.length].focus(); }
      else if (e.key === 'Home')      { e.preventDefault(); items[0].focus(); }
      else if (e.key === 'End')       { e.preventDefault(); items[items.length - 1].focus(); }
      else if (e.key === 'Escape')    { e.preventDefault(); close(); trigger.focus(); }
      else if (e.key === 'Tab')       { close(); }
    });
    document.addEventListener('click', (e) => {
      if (!dd.contains(e.target as Node)) close();
    });
  });

  // Mobile burger menu
  const burger = document.querySelector<HTMLButtonElement>('.nav-burger');
  const navEl = document.getElementById('nav');
  if (burger && navEl) {
    const setOpen = (open: boolean) => {
      burger.setAttribute('aria-expanded', open ? 'true' : 'false');
      burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      navEl.setAttribute('data-mobile-open', open ? 'true' : 'false');
      document.body.classList.toggle('nav-locked', open);
    };
    burger.addEventListener('click', () => setOpen(burger.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && burger.getAttribute('aria-expanded') === 'true') {
        setOpen(false); burger.focus();
      }
    });
    navEl.querySelectorAll<HTMLAnchorElement>('.nav-links a').forEach((a) => {
      a.addEventListener('click', () => {
        if (burger.getAttribute('aria-expanded') === 'true') setOpen(false);
      });
    });
    const mq = window.matchMedia('(min-width: 821px)');
    mq.addEventListener('change', (e) => {
      if (e.matches && burger.getAttribute('aria-expanded') === 'true') setOpen(false);
    });
  }
</script>
