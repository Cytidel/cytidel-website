---
import Layout from '../layouts/Layout.astro';
import { Picture } from 'astro:assets';
import mobileCve from '../assets/products/mobile-cve.png';
import villainVault from '../assets/products/villain-vault.png';
import inventoryIpad from '../assets/products/inventory-ipad.png';
import { faqs } from '../data/faqs.ts';

// FAQPage JSON-LD — same Q&A as the visible accordion, structured for
// Google's FAQ rich-result snippet on the homepage SERP.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};
---
<Layout
  title="Cytidel — The early warning layer for overwhelmed security teams"
  description="Stay ahead of emerging vulnerabilities, threat actors and supply chain risk. Cytidel surfaces what's dangerous, not just what's vulnerable."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <section class="hero" aria-labelledby="hero-h1">
    <div class="container">
      <div class="hero-inner">
        <span class="hero-eyebrow">The early warning layer for overwhelmed security teams</span>
        <h1 id="hero-h1">
          <span class="line-1">Your scanner tells you what's <span class="hi-soft">vulnerable.</span></span>
          <span class="line-2">Cytidel tells you what's <span class="hi-deep">dangerous.</span></span>
        </h1>
        <p class="hero-sub">Stay ahead of emerging vulnerabilities, threat actors and supply chain risk.</p>
        <div class="hero-cta">
          <a href="/book-a-demo" class="btn btn-primary" data-analytics="CTA|Book a Demo|Hero">
            Book a Demo
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="awards-strip" aria-label="Awards and recognition">
    <div class="container">
      <div class="awards-band">
        <div class="awards-grid">
          <div class="award-item">
            <span class="award-status">
              <svg class="award-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M7 4h10v5a5 5 0 0 1-10 0V4z"/>
                <path d="M7 6H4.5a2.5 2.5 0 0 0 2.5 4.5M17 6h2.5a2.5 2.5 0 0 1-2.5 4.5"/>
                <path d="M12 14v3M8.5 21h7M9.5 21a2.5 2.5 0 0 1 5 0"/>
              </svg>
              Grand Prix Winner
            </span>
            <div class="award-name">Irish National Startup of the Year, 2024</div>
          </div>
          <div class="award-item">
            <span class="award-status">
              <svg class="award-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M7 4h10v5a5 5 0 0 1-10 0V4z"/>
                <path d="M7 6H4.5a2.5 2.5 0 0 0 2.5 4.5M17 6h2.5a2.5 2.5 0 0 1-2.5 4.5"/>
                <path d="M12 14v3M8.5 21h7M9.5 21a2.5 2.5 0 0 1 5 0"/>
              </svg>
              Finalist
            </span>
            <div class="award-name">Cyber Startup Award, Infosecurity Europe 2026</div>
          </div>
          <div class="award-item">
            <span class="award-status">
              <svg class="award-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M7 4h10v5a5 5 0 0 1-10 0V4z"/>
                <path d="M7 6H4.5a2.5 2.5 0 0 0 2.5 4.5M17 6h2.5a2.5 2.5 0 0 1-2.5 4.5"/>
                <path d="M12 14v3M8.5 21h7M9.5 21a2.5 2.5 0 0 1 5 0"/>
              </svg>
              Finalist
            </span>
            <div class="award-name">ECSO CISO Choice Award, 2026</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="product-showcase" aria-label="Product preview">
    <div class="showcase-track">
      <div class="container">
        <div class="showcase-stage">
          <figure class="showcase-card showcase-card-left device-phone">
            <div class="device-frame">
              <span class="device-notch" aria-hidden="true"></span>
              <div class="device-screen">
                <Picture
                  src={mobileCve}
                  alt="Cytidel on mobile — a CVE detail view with risk rating, signals, and key metrics."
                  widths={[300, 450, 600]}
                  sizes="(max-width: 879px) 70vw, 220px"
                  formats={['avif', 'webp']}
                  loading="eager"
                  fetchpriority="high"
                />
              </div>
            </div>
          </figure>
          <figure class="showcase-card showcase-card-center device-desktop">
            <div class="device-frame">
              <div class="device-chrome" aria-hidden="true">
                <span class="dot"></span><span class="dot"></span><span class="dot"></span>
              </div>
              <div class="device-screen">
                <Picture
                  src={villainVault}
                  alt="Cytidel Villain Vault — adversary profiles mapped to CVEs in their arsenal, with TTPs and campaign history."
                  widths={[600, 900, 1200, 1600]}
                  sizes="(max-width: 879px) 85vw, 640px"
                  formats={['avif', 'webp']}
                  loading="eager"
                  fetchpriority="high"
                />
              </div>
            </div>
          </figure>
          <figure class="showcase-card showcase-card-right device-tablet">
            <div class="device-frame">
              <div class="device-screen">
                <Picture
                  src={inventoryIpad}
                  alt="Cytidel on tablet — inventory of vendors and products under continuous monitoring."
                  widths={[480, 720, 960]}
                  sizes="(max-width: 879px) 80vw, 380px"
                  formats={['avif', 'webp']}
                  loading="eager"
                  fetchpriority="high"
                />
              </div>
            </div>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <section class="proof-strip" aria-label="At a glance">
    <div class="container">
      <div class="proof-strip-grid">
        <div class="proof-item">
          <div class="num"><strong>51 days faster</strong> than CISA KEV on average</div>
          <p>Median 6 days, up to 19 months in the longest cases.</p>
        </div>
        <div class="proof-item">
          <div class="num"><strong>Thousands of sources</strong> monitored continuously</div>
          <p>Exploit code, threat actors, advisories, news, social.</p>
        </div>
        <div class="proof-item">
          <div class="num"><strong>ISO 27001:2022</strong> certified</div>
          <p>Built by ISO 27001 auditors.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="monday-morning" aria-labelledby="morning-h2">
    <div class="container">
      <h2 id="morning-h2">A typical morning</h2>
      <div class="morning-grid">
        <div class="morning-stats">
          <div class="stat-card">
            <span class="big">300–400</span>
            <p>vulnerabilities cross your team's desk every day.</p>
          </div>
          <div class="stat-card">
            <span class="big">Hundreds</span>
            <p>of suppliers and software components to monitor — continuously, not annually.</p>
          </div>
          <blockquote class="morning-pull">"The workload doubles every two years. The threat landscape is accelerating. Your team hasn't."</blockquote>
        </div>
        <div class="morning-help">
          <h3>How Cytidel helps</h3>
          <p>Cytidel processes all of them — and shows you the two or three that actually matter, with the evidence, the threat actor context, and the exploitation signals behind every call.</p>
        </div>
      </div>
      <div class="deeper-link">
        <a href="/why-cytidel">→ Read the full picture on Why Cytidel</a>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <section class="what" aria-labelledby="what-h2">
    <div class="container">
      <h2 id="what-h2">What Cytidel does</h2>
      <p>Cytidel is a risk intelligence platform. We monitor thousands of sources continuously, 24/7, across the three things that matter to your security posture:</p>

      <div class="domain-cards">
        <article class="domain-card">
          <div class="icon" aria-hidden="true">
            <svg viewBox="0 0 36 36" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
              <rect x="5" y="8" width="26" height="4" rx="1"/>
              <rect x="5" y="16" width="26" height="4" rx="1" stroke="#80FC13"/>
              <rect x="5" y="24" width="17" height="4" rx="1"/>
            </svg>
          </div>
          <h4>Vulnerabilities</h4>
          <p>Every new vulnerability tagged with exploitation evidence, threat actor activity, and exploit availability — in real time.</p>
        </article>

        <article class="domain-card">
          <div class="icon" aria-hidden="true">
            <svg viewBox="0 0 36 36" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
              <line x1="9" y1="10" x2="27" y2="13"/>
              <line x1="9" y1="10" x2="18" y2="27"/>
              <line x1="27" y1="13" x2="18" y2="27"/>
              <circle cx="9" cy="10" r="3" fill="var(--color-bg-elev)"/>
              <circle cx="27" cy="13" r="3" fill="#80FC13" stroke="#80FC13"/>
              <circle cx="18" cy="27" r="3" fill="var(--color-bg-elev)"/>
            </svg>
          </div>
          <h4>Threat actors</h4>
          <p>Every known adversary mapped to the vulnerabilities in their arsenal, with TTP and campaign context.</p>
        </article>

        <article class="domain-card">
          <div class="icon" aria-hidden="true">
            <svg viewBox="0 0 36 36" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
              <rect x="3" y="13" width="8" height="10" rx="1.5"/>
              <rect x="14" y="13" width="8" height="10" rx="1.5" stroke="#80FC13"/>
              <rect x="25" y="13" width="8" height="10" rx="1.5"/>
              <line x1="11" y1="18" x2="14" y2="18"/>
              <line x1="22" y1="18" x2="25" y2="18"/>
            </svg>
          </div>
          <h4>Suppliers and software</h4>
          <p>24/7 monitoring of the vendors and software your team depends on — including breaches, advisories, and threat actor activity.</p>
        </article>
      </div>

      <p>Because we're watching all three continuously, we see the signal before anyone else does.</p>
    </div>
  </section>

  <section class="spotlight-section" aria-labelledby="spotlight-h3">
    <div class="container">
      <div class="spotlight-card">
        <span class="eyebrow">Intelligence feature</span>
        <h3 id="spotlight-h3" class="spotlight-headline">Cytidel Spotlight: Emerging Threats</h3>
        <p class="spotlight-supporting">Spotlight surfaces the vulnerabilities most likely to be exploited, before they have a chance to land. Around 1% of vulnerabilities make the list, based on early exploitation signals: proof-of-concept code, exploit availability, threat actor association, or chatter in places most teams don't watch. Around 70% of those have gone on to be exploited or weaponised in the wild.</p>
        <p class="spotlight-supporting">When we look at the data, we're <span class="lead-num">51 days faster than CISA KEV on average</span>, giving customers the early warning to act. Median 6 days, up to 19 months in the longest cases.</p>

        <figure class="spotlight-chart" role="figure" aria-label="Cytidel Spotlight surfaces signals at Day 0. CISA KEV catches up with a median delay of 6 days, a mean of 51 days, and in the longest cases 19 months — roughly 578 days.">
          <svg viewBox="0 0 760 290" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
            <line x1="180" y1="48" x2="180" y2="210" stroke="#25252b" stroke-width="1" stroke-dasharray="3 5"/>
            <text x="180" y="32" fill="#a1a1aa" font-family="'Mona Sans', ui-monospace, SF Mono, Menlo, monospace" font-size="11" font-weight="500" text-anchor="middle" letter-spacing="0.08em">DAY 0</text>
            <text x="20" y="94" fill="#fafafa" font-family="'Mona Sans', ui-monospace, SF Mono, Menlo, monospace" font-size="14" font-weight="600">Cytidel Spotlight</text>
            <text x="20" y="112" fill="#71717a" font-family="'Mona Sans', ui-monospace, SF Mono, Menlo, monospace" font-size="12">Signal surfaces</text>
            <line x1="180" y1="100" x2="720" y2="100" stroke="#80FC13" stroke-width="2" stroke-linecap="round" stroke-opacity="0.55"/>
            <circle cx="180" cy="100" r="11" fill="#80FC13" fill-opacity="0.18"/>
            <circle cx="180" cy="100" r="5.5" fill="#80FC13"/>
            <text x="20" y="174" fill="#fafafa" font-family="'Mona Sans', ui-monospace, SF Mono, Menlo, monospace" font-size="14" font-weight="600">CISA KEV</text>
            <text x="20" y="192" fill="#71717a" font-family="'Mona Sans', ui-monospace, SF Mono, Menlo, monospace" font-size="12">Signal catches up</text>
            <line x1="180" y1="162" x2="720" y2="162" stroke="#34343b" stroke-width="2" stroke-linecap="round"/>
            <circle cx="245" cy="162" r="5" fill="#a1a1aa"/>
            <circle cx="390" cy="162" r="5" fill="#a1a1aa"/>
            <circle cx="680" cy="162" r="6.5" fill="#80FC13" fill-opacity="0.18"/>
            <circle cx="680" cy="162" r="5.5" fill="#80FC13"/>
            <line x1="245" y1="168" x2="245" y2="196" stroke="#34343b" stroke-width="1"/>
            <line x1="390" y1="168" x2="390" y2="196" stroke="#34343b" stroke-width="1"/>
            <line x1="680" y1="168" x2="680" y2="196" stroke="#80FC13" stroke-width="1" stroke-opacity="0.4"/>
            <text x="245" y="212" fill="#71717a" font-family="'Mona Sans', ui-monospace, SF Mono, Menlo, monospace" font-size="10" font-weight="600" text-anchor="middle" letter-spacing="0.12em">MEDIAN</text>
            <text x="245" y="232" fill="#fafafa" font-family="'Mona Sans', ui-monospace, SF Mono, Menlo, monospace" font-size="14" font-weight="600" text-anchor="middle">6 days</text>
            <text x="390" y="212" fill="#71717a" font-family="'Mona Sans', ui-monospace, SF Mono, Menlo, monospace" font-size="10" font-weight="600" text-anchor="middle" letter-spacing="0.12em">MEAN</text>
            <text x="390" y="232" fill="#fafafa" font-family="'Mona Sans', ui-monospace, SF Mono, Menlo, monospace" font-size="14" font-weight="600" text-anchor="middle">51 days</text>
            <text x="680" y="212" fill="#80FC13" font-family="'Mona Sans', ui-monospace, SF Mono, Menlo, monospace" font-size="10" font-weight="600" text-anchor="middle" letter-spacing="0.12em">LONGEST</text>
            <text x="680" y="232" fill="#fafafa" font-family="'Mona Sans', ui-monospace, SF Mono, Menlo, monospace" font-size="14" font-weight="600" text-anchor="middle">19 months</text>
            <text x="680" y="250" fill="#71717a" font-family="'Mona Sans', ui-monospace, SF Mono, Menlo, monospace" font-size="11" font-style="italic" text-anchor="middle">≈ 578 days</text>
            <text x="180" y="280" fill="#52525b" font-family="'Mona Sans', ui-monospace, SF Mono, Menlo, monospace" font-size="10" letter-spacing="0.04em">Horizontal axis compressed for readability. All deltas measured against CISA KEV publication.</text>
          </svg>
        </figure>

        <p class="spotlight-supporting">Every alert comes with the evidence, the threat actor context, and the exploitation signals behind it. No tuning required. No new tabs to check. The intelligence flows into where your team already works.</p>

        <div class="spotlight-footer">
          <a href="/cytidel-platform">→ See the full platform</a>
        </div>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <section class="proof" aria-label="Proof">
    <div class="container">
      <div class="proof-grid">
        <div class="proof-main">
          <figure class="proof-quote">
            <q>Cytidel has enhanced the efficiency of our security operations by 95%. It is like having an extra team member dedicated to vulnerability intelligence.</q>
            <cite>— Threat Intelligence Manager, An Post</cite>
          </figure>
          <div class="proof-stats">
            <div class="stat"><div class="num">98%</div><div class="label">Reduction in alert volume</div></div>
            <div class="stat"><div class="num">4–8</div><div class="label">FTEs of capacity freed</div></div>
          </div>
        </div>
        <div class="proof-aside">
          <figure class="small-quote">
            <q>This gives me the reassurance that I know I'm not missing something huge in the community.</q>
            <cite>— Vulnerability Analyst</cite>
          </figure>
          <figure class="small-quote">
            <q>Cytidel's data collection is better than anything else I've seen on the market.</q>
            <cite>— Threat Intelligence Specialist</cite>
          </figure>
          <figure class="small-quote">
            <q>The speed and accuracy of your work repeatedly keeps me ahead of the threats and the news-cycle.</q>
            <cite>— Cytidel customer</cite>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <section class="faq" aria-labelledby="faq-h2">
    <div class="container">
      <h2 id="faq-h2">The questions that come up most</h2>
      <div class="faq-list" role="list">
        {faqs.map((faq) => (
          <details class="faq-item" role="listitem">
            <summary class="faq-q">
              <span>{faq.question}</span>
              <span class="icon" aria-hidden="true"></span>
            </summary>
            <div class="faq-a"><div class="faq-a-inner">
              {faq.answer}
            </div></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <section class="final-cta" aria-labelledby="final-cta-h2">
    <div class="container">
      <div class="final-cta-card">
        <h2 id="final-cta-h2">Ready to see Cytidel?</h2>
        <p>Meet with a Cytidel expert to discuss how you can get ahead of emerging threats, understand the latest threat actor activity relevant to your business, and monitor critical software and suppliers 24/7.</p>
        <a href="/book-a-demo" class="btn btn-primary" data-analytics="CTA|Book a Demo|Final CTA">
          Book a Demo
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  const items = document.querySelectorAll<HTMLDetailsElement>('.faq-item');
  items.forEach((item) => {
    const summary = item.querySelector('.faq-q');
    summary?.addEventListener('click', () => {
      setTimeout(() => {
        if (item.open) {
          items.forEach((other) => {
            if (other !== item) other.removeAttribute('open');
          });
        }
      }, 0);
    });
  });
</script>

<style>
  /* Container + section defaults */
  .container {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding-left: clamp(20px, 4vw, 48px);
    padding-right: clamp(20px, 4vw, 48px);
  }
  section {
    padding-top: clamp(48px, 6vw, 88px);
    padding-bottom: clamp(48px, 6vw, 88px);
  }
  .divider {
    max-width: 1280px;
    margin: 0 auto;
    border-top: 1px solid var(--color-border);
    opacity: 0.6;
  }

  /* Shared headings */
  .hero h1,
  .monday-morning h2,
  .what h2,
  .faq h2,
  .morning-help h3,
  .spotlight-headline,
  .final-cta-card h2 {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--color-text);
    letter-spacing: -0.02em;
    margin: 0;
  }

  /* Hero */
  .hero {
    padding-top: clamp(40px, 6vw, 80px);
    padding-bottom: clamp(24px, 3.5vw, 44px);
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: "";
    position: absolute;
    top: -200px;
    left: 50%;
    transform: translateX(-50%);
    width: 1200px;
    height: 800px;
    background: radial-gradient(ellipse at center, rgba(128, 252, 19, 0.18) 0%, transparent 65%);
    pointer-events: none;
    z-index: 0;
  }
  .hero-inner { position: relative; z-index: 1; }
  .hero-eyebrow {
    display: inline-block;
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--color-accent-deep);
    margin-bottom: 22px;
    line-height: 1.4;
  }
  .hero h1 {
    font-size: clamp(3rem, 8.2vw, 6.6rem);
    line-height: 1.03;
    letter-spacing: -0.03em;
  }
  .hero h1 .line-1,
  .hero h1 .line-2 { color: var(--color-text); display: block; }
  .hi-soft,
  .hi-deep { color: var(--color-accent-deep); }
  .hero-sub {
    margin: 28px 0 0;
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    line-height: 1.55;
    color: var(--color-text-secondary);
  }
  .hero-cta { margin-top: 40px; }

  /* Awards strip */
  .awards-strip {
    padding-top: clamp(4px, 1vw, 10px);
    padding-bottom: clamp(44px, 6vw, 76px);
  }
  .awards-band {
    background: linear-gradient(135deg, #1f2823 0%, #0e1612 100%);
    border-radius: 12px;
    padding: clamp(13px, 1.6vw, 18px) clamp(20px, 2.8vw, 40px);
  }
  .awards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
  }
  .award-item {
    padding: 0 clamp(12px, 1.8vw, 22px);
    border-left: 1px solid var(--color-dark-border);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .award-item:first-child { border-left: none; padding-left: 0; }
  .award-item:last-child { padding-right: 0; }
  .award-status {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .award-icon { width: 14px; height: 14px; color: var(--color-accent); flex-shrink: 0; }
  .award-name {
    font-family: var(--font-display);
    font-size: clamp(0.78rem, 1vw, 0.9rem);
    font-weight: 500;
    color: var(--color-dark-text);
    letter-spacing: -0.01em;
    line-height: 1.35;
    text-wrap: balance;
  }
  @media (max-width: 760px) {
    .awards-grid { grid-template-columns: 1fr; gap: 14px; }
    .award-item { border-left: none; padding: 0; }
    .award-item + .award-item {
      padding-top: 14px;
      border-top: 1px solid var(--color-dark-border);
    }
  }

  /* ------------------------------------------------------------------
     Product showcase
     ------------------------------------------------------------------
     Desktop: 3 cards start stacked (slight fan) in the centre and
     spread out to a horizontal row as the section scrolls through the
     viewport. Driven by CSS `animation-timeline: view()` — no JS.
     Browsers without scroll-driven animation support (currently
     Firefox) get the final spread layout, which is the sane fallback.
     Mobile: switches to a horizontal scroll-snap carousel.
     ------------------------------------------------------------------ */
  .product-showcase {
    padding-top: 0;
    padding-bottom: clamp(48px, 6vw, 80px);
    position: relative;
  }
  .product-showcase::before {
    content: "";
    position: absolute;
    top: -80px;
    left: 50%;
    transform: translateX(-50%);
    width: 70%;
    height: 140px;
    background: radial-gradient(ellipse at center, rgba(128, 252, 19, 0.18) 0%, transparent 65%);
