---
import Layout from '../layouts/Layout.astro';
import { faqs } from '../data/faqs.ts';

// FAQPage schema for Google rich results — same Q&A pairs as the visible
// accordion, just structured for crawlers. Lives in a head slot below.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};
---
<Layout
  title="FAQ · Cytidel"
  description="The questions security teams ask before choosing Cytidel — and how we answer them."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>
  <section class="hero faq-hero" aria-labelledby="hero-h1">
    <div class="container">
      <div class="hero-inner">
        <span class="eyebrow">FAQ</span>
        <h1 id="hero-h1">Frequently asked questions</h1>
        <p class="hero-sub">The questions security teams ask before choosing Cytidel — and how we answer them.</p>
      </div>
    </div>
  </section>

  <section class="faq" aria-labelledby="faq-h2">
    <div class="container">
      <h2 id="faq-h2" class="sr-only">Frequently asked questions</h2>
      <div class="faq-list" role="list">
        {faqs.map((faq) => (
          <details class="faq-item" role="listitem">
            <summary class="faq-q">
              <span>{faq.question}</span>
              <span class="icon" aria-hidden="true"></span>
            </summary>
            <div class="faq-a"><div class="faq-a-inner">
              {faq.answer}
            </div></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="final-cta" aria-labelledby="final-cta-h2">
    <div class="container">
      <h2 id="final-cta-h2">Have a question we haven't answered?</h2>
      <p>Book a 20-minute call. Bring your specific question — pricing, integrations, threat actor coverage, ISO 27001, MSSP programme — and we'll walk you through it.</p>
      <a href="/book-a-demo" class="btn btn-primary" data-analytics="CTA|Book a Demo|FAQ Final CTA">
        Book a Demo
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Layout>

<script>
  // Single-open FAQ accordion. <details> handles toggle natively; we add
  // close-others behaviour after the native toggle has fired.
  const items = document.querySelectorAll<HTMLDetailsElement>('.faq-item');
  items.forEach((item) => {
    const summary = item.querySelector('.faq-q');
    summary?.addEventListener('click', () => {
      setTimeout(() => {
        if (item.open) {
          items.forEach((other) => {
            if (other !== item) other.removeAttribute('open');
          });
        }
      }, 0);
    });
  });
</script>

<style>
  /* Container + section defaults — match the original page */
  .container {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding-left: clamp(20px, 4vw, 48px);
    padding-right: clamp(20px, 4vw, 48px);
  }
  section {
    padding-top: clamp(48px, 6vw, 88px);
    padding-bottom: clamp(48px, 6vw, 88px);
  }

  /* Hero — base + .faq-hero override */
  .hero {
    padding-top: clamp(80px, 11vw, 140px);
    padding-bottom: clamp(56px, 8vw, 100px);
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: "";
    position: absolute;
    top: -200px;
    left: 50%;
    transform: translateX(-50%);
    width: 1200px;
    height: 700px;
    background: radial-gradient(ellipse at center, rgba(128, 252, 19, 0.18) 0%, transparent 65%);
    pointer-events: none;
    z-index: 0;
  }
  .hero-inner { position: relative; z-index: 1; }
  .faq-hero {
    padding-top: clamp(80px, 10vw, 120px);
    padding-bottom: clamp(40px, 5vw, 60px);
  }
  .faq-hero .hero-sub { margin-top: 20px; }

  .eyebrow {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent-deep);
    margin-bottom: 1.25rem;
  }

  .hero h1 {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.028em;
    line-height: 1.06;
    margin: 0;
    color: var(--color-text);
    font-size: clamp(2.4rem, 5.6vw, 4rem);
  }
  .hero-sub {
    margin: 28px 0 0;
    font-size: clamp(1.05rem, 1.55vw, 1.22rem);
    line-height: 1.55;
    color: var(--color-text-secondary);
  }

  /* Visually-hidden helper for the off-screen FAQ h2 */
  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* FAQ list */
  .faq-item {
    border-bottom: 1px solid var(--color-border);
  }
  .faq-q {
    width: 100%;
    background: transparent;
    border: none;
    color: var(--color-text);
    padding: 22px 0;
    text-align: left;
    font-size: clamp(1rem, 1.5vw, 1.12rem);
    font-weight: 500;
    letter-spacing: -0.005em;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    transition: color 0.15s ease;
    cursor: pointer;
    list-style: none; /* hide native <summary> marker */
  }
  .faq-q::-webkit-details-marker { display: none; }
  .faq-q:hover { color: var(--color-accent-deep); }
  .faq-q:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: 4px;
  }
  .faq-q .icon {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    position: relative;
    color: var(--color-text-tertiary);
  }
  .faq-q .icon::before,
  .faq-q .icon::after {
    content: "";
    position: absolute;
    background: currentColor;
    top: 50%;
    left: 50%;
    transform-origin: center;
    transition: transform 0.2s ease;
  }
  .faq-q .icon::before { width: 14px; height: 1.5px; transform: translate(-50%, -50%); }
  .faq-q .icon::after  { width: 1.5px; height: 14px; transform: translate(-50%, -50%); }
  .faq-item[open] .faq-q { color: var(--color-text); }
  .faq-item[open] .faq-q .icon::after { transform: translate(-50%, -50%) scaleY(0); }

  .faq-a {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
    color: var(--color-text-secondary);
  }
  .faq-item[open] .faq-a { max-height: 1600px; }
  .faq-a-inner {
    padding: 0 0 28px;
    font-size: 1rem;
    line-height: 1.7;
  }

  /* Final CTA (FAQ-specific copy + Book a Demo button) */
  .final-cta {
    text-align: center;
    border-top: 1px solid var(--color-border);
  }
  .final-cta h2 {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.018em;
    line-height: 1.08;
    color: var(--color-text);
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    margin: 0 0 20px;
  }
  .final-cta p {
    font-size: clamp(1.02rem, 1.5vw, 1.15rem);
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0 0 36px;
    max-width: 640px;
    margin-left: auto;
    margin-right: auto;
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 22px;
    border-radius: 10px;
    font-weight: 600;
    font-size: 0.98rem;
    transition: transform 0.15s ease, background 0.15s ease, box-shadow 0.2s ease;
    border: 1px solid transparent;
    text-decoration: none;
  }
  .btn-primary {
    background: #80FC13;
    color: #0b2000;
  }
  .btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 30px rgba(128, 252, 19, 0.35);
  }
  .btn .arrow { transition: transform 0.2s ease; }
  .btn:hover .arrow { transform: translateX(3px); }
</style>
