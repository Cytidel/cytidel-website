---
import Layout from '../layouts/Layout.astro';

// HubSpot Forms API submission endpoint params — public values, safe to
// inline in the client bundle.
const HUBSPOT_PORTAL_ID = '25744711';
const HUBSPOT_FORM_GUID = '9179311d-fdc5-4b22-b83e-f24ad76b3ddc';
const HUBSPOT_MEETING_URL = 'https://meetings-eu1.hubspot.com/gary-fagan/book-a-demo';
---
<Layout
  title="Book a Demo · Cytidel"
  description="Meet with a Cytidel expert to discuss how you can get ahead of emerging threats, understand latest threat actor activity, and monitor your software and suppliers 24/7."
>
  <Fragment slot="head">
    <!-- Warm the connections we'll need: HubSpot Forms API for lead
         capture on submit, and HubSpot Meetings for the redirect right
         after. Both fire shortly after the user clicks submit, so the
         preconnects in <head> save a chunk of time at that moment. -->
    <link rel="preconnect" href="https://api.hsforms.com" crossorigin />
    <link rel="preconnect" href="https://meetings-eu1.hubspot.com" crossorigin />
  </Fragment>

  <section class="demo-section" aria-labelledby="hero-h1">
    <div class="container">
      <div class="demo-grid">
        <div class="demo-intro">
          <span class="eyebrow">Book a demo</span>
          <h1 id="hero-h1">Find out what Cytidel can do for your business</h1>
          <p class="hero-sub">Meet with a Cytidel expert to discuss how you can get ahead of emerging threats, understand latest threat actor activity, and monitor your software and suppliers 24/7.</p>
        </div>

        <div class="demo-form-wrap">
          <form
            id="book-demo-form"
            class="demo-form"
            data-portal-id={HUBSPOT_PORTAL_ID}
            data-form-guid={HUBSPOT_FORM_GUID}
            data-meeting-url={HUBSPOT_MEETING_URL}
          >
            <div class="field-row">
              <div class="field">
                <label for="firstname">First name <span class="req" aria-hidden="true">*</span></label>
                <input id="firstname" name="firstname" type="text" required autocomplete="given-name" placeholder=" " />
              </div>
              <div class="field">
                <label for="lastname">Last name <span class="req" aria-hidden="true">*</span></label>
                <input id="lastname" name="lastname" type="text" required autocomplete="family-name" placeholder=" " />
              </div>
            </div>

            <div class="field">
              <label for="email">Work email <span class="req" aria-hidden="true">*</span></label>
              <input id="email" name="email" type="email" required autocomplete="email" placeholder=" " />
            </div>

            <div class="field">
              <label for="company">Company <span class="req" aria-hidden="true">*</span></label>
              <input id="company" name="company" type="text" required autocomplete="organization" placeholder=" " />
            </div>

            <div class="form-actions">
              <button type="submit" class="btn btn-primary" data-analytics="CTA|Book a Demo|Form Submit">
                <span class="btn-label">Continue to scheduling</span>
                <span class="arrow" aria-hidden="true">→</span>
              </button>
            </div>

            <p class="form-note">After submitting, you'll pick a time that works for you on the next page. By submitting you agree to our <a href="/privacy">Privacy Policy</a>.</p>

            <div class="form-status" role="status" aria-live="polite"></div>
          </form>

          <noscript>
            <div class="noscript-fallback">
              JavaScript is required to submit this form. Please email <a href="mailto:info@cytidel.com">info@cytidel.com</a> to book a demo directly.
            </div>
          </noscript>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Native form → HubSpot Forms API → redirect to HubSpot Meetings with
  // the visitor's details prefilled as query-string params. The Forms API
  // submission captures the lead in HubSpot CRM even if the visitor bails
  // before picking a calendar slot.

  type HSFormsField = { objectTypeId: string; name: string; value: string };

  const form = document.getElementById('book-demo-form') as HTMLFormElement | null;
  if (form) {
    const portalId = form.dataset.portalId!;
    const formGuid = form.dataset.formGuid!;
    const meetingUrl = form.dataset.meetingUrl!;
    const status = form.querySelector('.form-status') as HTMLElement;
    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const submitLabel = submitBtn.querySelector('.btn-label') as HTMLElement;
    const originalLabel = submitLabel.textContent ?? '';

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.textContent = '';
      status.classList.remove('is-error');

      const data = new FormData(form);
      const firstname = (data.get('firstname') ?? '').toString().trim();
      const lastname = (data.get('lastname') ?? '').toString().trim();
      const email = (data.get('email') ?? '').toString().trim();
      const company = (data.get('company') ?? '').toString().trim();

      const fields: HSFormsField[] = [
        { objectTypeId: '0-1', name: 'firstname', value: firstname },
        { objectTypeId: '0-1', name: 'lastname', value: lastname },
        { objectTypeId: '0-1', name: 'email', value: email },
        { objectTypeId: '0-1', name: 'company', value: company },
      ];

      submitBtn.disabled = true;
      submitLabel.textContent = 'Submitting…';

      try {
        const res = await fetch(
          `https://api.hsforms.com/submissions/v3/integration/submit/${portalId}/${formGuid}`,
          {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              fields,
              context: {
                pageUri: window.location.href,
                pageName: document.title,
              },
            }),
          },
        );

        if (!res.ok) {
          throw new Error(`HubSpot Forms API returned ${res.status}`);
        }

        // Matomo conversion event — fires only on actual successful submit,
        // gated by Cookiebot consent like everything else.
        (window as unknown as { _paq?: unknown[][] })._paq?.push(['trackEvent', 'Form', 'Book a Demo', 'Submit']);

        // Redirect to the HubSpot Meetings scheduler with the visitor's
        // details prefilled. HubSpot Meetings reads these query-string
        // params natively and skips the "who are you" step.
        const params = new URLSearchParams({
          firstName: firstname,
          lastName: lastname,
          email,
          company,
        });
        window.location.href = `${meetingUrl}?${params.toString()}`;
      } catch (err) {
        console.error('Book a demo form submit failed:', err);
        status.textContent = 'Something went wrong submitting the form. Please try again, or email info@cytidel.com.';
        status.classList.add('is-error');
        submitBtn.disabled = false;
        submitLabel.textContent = originalLabel;
        (window as unknown as { _paq?: unknown[][] })._paq?.push(['trackEvent', 'Form', 'Book a Demo', 'Error']);
      }
    });
  }
</script>

<style>
  /* Container + section defaults */
  .container {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding-left: clamp(20px, 4vw, 48px);
    padding-right: clamp(20px, 4vw, 48px);
  }
  section {
    padding-top: clamp(48px, 6vw, 88px);
    padding-bottom: clamp(48px, 6vw, 88px);
  }

  /* Two-column layout — copy on the left, form on the right. Stacks on
     narrower screens. */
  .demo-section {
    padding-top: clamp(80px, 10vw, 120px);
    padding-bottom: clamp(72px, 9vw, 120px);
    position: relative;
    overflow: hidden;
  }
  .demo-section::before {
    content: "";
    position: absolute;
    top: -200px;
    left: 50%;
    transform: translateX(-50%);
    width: 1200px;
    height: 700px;
    background: radial-gradient(ellipse at center, rgba(128, 252, 19, 0.18) 0%, transparent 65%);
    pointer-events: none;
    z-index: 0;
  }
  .demo-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(40px, 6vw, 80px);
    align-items: start;
  }
  @media (max-width: 880px) {
    .demo-grid { grid-template-columns: 1fr; gap: clamp(32px, 5vw, 48px); }
  }

  .demo-intro { max-width: 560px; }
  .eyebrow {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent-deep);
    margin-bottom: 1.25rem;
  }
  .demo-intro h1 {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.06;
    margin: 0;
    color: var(--color-text);
    /* Slightly tighter than the wide-hero clamp because the column is
       narrower now — keeps the headline from looking out of scale. */
    font-size: clamp(2.1rem, 4.4vw, 3.2rem);
    text-wrap: balance;
  }
  .hero-sub {
    margin: 22px 0 0;
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  /* Form */
  .demo-form-wrap { width: 100%; }
  .demo-form {
    max-width: 540px;
    width: 100%;
    margin: 0;
    display: grid;
    gap: clamp(18px, 2.5vw, 22px);
    padding: clamp(28px, 4vw, 40px);
    background: var(--color-bg-elev);
    border: 1px solid var(--color-border);
    border-radius: 12px;
  }
  @media (max-width: 880px) {
    .demo-form { margin: 0 auto; }
  }
  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(14px, 2vw, 18px);
  }
  @media (max-width: 520px) {
    .field-row { grid-template-columns: 1fr; gap: clamp(18px, 2.5vw, 22px); }
  }
  .field {
    display: grid;
    gap: 6px;
  }
  .field label {
    font-family: var(--font-sans);
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--color-text);
    letter-spacing: -0.005em;
  }
  .field label .req {
    color: var(--color-accent-deep);
    margin-left: 2px;
  }
  .field input {
    font: inherit;
    font-size: 1rem;
    padding: 12px 14px;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: #fff;
    color: var(--color-text);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .field input::placeholder { color: var(--color-text-tertiary); opacity: 0.6; }
  .field input:focus {
    outline: none;
    border-color: var(--color-accent-deep);
    box-shadow: 0 0 0 3px rgba(53, 122, 18, 0.15);
  }
  .field input:invalid:not(:placeholder-shown) {
    border-color: #b94a48;
  }

  .form-actions { margin-top: 4px; }
  .form-actions .btn {
    width: 100%;
    justify-content: center;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 22px;
    border-radius: 10px;
    font-weight: 600;
    font-size: 0.98rem;
    font-family: inherit;
    transition: transform 0.15s ease, box-shadow 0.2s ease, opacity 0.15s ease;
    border: 1px solid transparent;
    text-decoration: none;
    cursor: pointer;
  }
  .btn-primary {
    background: #80FC13;
    color: #0b2000;
  }
  .btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 30px rgba(128, 252, 19, 0.35);
  }
  .btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
  }
  .btn .arrow { transition: transform 0.2s ease; }
  .btn:hover:not(:disabled) .arrow { transform: translateX(3px); }

  .form-note {
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--color-text-tertiary);
    margin: 0;
    text-align: center;
  }
  .form-note a {
    color: var(--color-accent-deep);
    font-weight: 600;
    text-decoration: none;
  }
  .form-note a:hover { text-decoration: underline; }

  .form-status {
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
    min-height: 0;
  }
  .form-status:not(:empty) {
    min-height: 1.5em;
    padding-top: 4px;
  }
  .form-status.is-error {
    color: #b94a48;
  }

  .noscript-fallback {
    max-width: 540px;
    margin: 16px auto 0;
    padding: 16px 20px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--color-text);
    text-align: center;
  }
  .noscript-fallback a { color: var(--color-accent-deep); font-weight: 600; }
</style>
