---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
}
const {
  title = 'Cytidel',
  description,
  ogImage,
  ogType,
} = Astro.props;

// Organization JSON-LD — emitted sitewide so Google's knowledge panel
// (logo, social links, description in the right-side card on search
// results) has the data it needs.
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Cytidel',
  url: 'https://cytidel.com',
  logo: 'https://cytidel.com/img/logo_light_backgrounds.svg',
  description: 'The early warning layer for vulnerabilities, threat actors and supplier risk.',
  sameAs: ['https://www.linkedin.com/company/cytidel/'],
};
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Cookiebot consent management. Must be the first script in <head>
         so its auto-blocking can intercept tracker scripts (Matomo below)
         before they fire. CBID is the same one used on the existing
         Webflow site at cytidel.com — the new Astro domain needs to be
         added to the Cookiebot dashboard allowlist before this works in
         production. -->
    <script
      is:inline
      id="Cookiebot"
      src="https://consent.cookiebot.com/uc.js"
      data-cbid="aa407693-b2ed-4e09-886f-cac747660436"
      type="text/javascript"
    ></script>

    <SEO title={title} description={description} ogImage={ogImage} ogType={ogType} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <link rel="icon" type="image/svg+xml" href="/img/favicon.svg" />
    <meta name="theme-color" content="#f1f1ec" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Mona+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <!-- Matomo Cloud — analytics for cytidel.com.

         Tiered consent model:
         - Default (no consent / declined): Matomo runs in cookieless
           mode via `requireCookieConsent`. Page views, events, devices
           and referrers are tracked anonymously, no cookies set. This
           sits inside CNIL's "measurement only" exemption from
           ePrivacy consent, on the assumption that Matomo Cloud's
           default IP anonymisation is on (confirm in Matomo settings).
         - On accepting Statistics: Matomo upgrades to full cookie
           mode — return-visitor tracking, sessions, funnels light up
           for that visitor going forward.
         - On withdrawing: Matomo downgrades back to cookieless.

         Both <script> tags are marked `data-cookieconsent="ignore"`
         so Cookiebot's auto-blocker leaves Matomo alone (Matomo is
         handling its own consent gating via `_paq`). The
         Cookiebot/Matomo sync listener below wires the events. -->
    <script is:inline data-cookieconsent="ignore">
      var _paq = window._paq = window._paq || [];
      _paq.push(['requireCookieConsent']);
      _paq.push(['setTrackerUrl', 'https://cytidel.matomo.cloud/matomo.php']);
      _paq.push(['setSiteId', '1']);
      _paq.push(['trackPageView']);
      _paq.push(['enableLinkTracking']);
    </script>
    <script is:inline async src="https://cdn.matomo.cloud/cytidel.matomo.cloud/matomo.js" data-cookieconsent="ignore"></script>
    <script is:inline data-cookieconsent="ignore">
      // Cookiebot ↔ Matomo consent bridge. Fires on initial page load
      // for returning visitors (CookiebotOnConsentReady) and when the
      // consent state changes (Accept / Decline).
      (function() {
        function syncMatomoConsent() {
          if (!window.Cookiebot || !window.Cookiebot.consent) return;
          if (window.Cookiebot.consent.statistics) {
            window._paq.push(['setCookieConsentGiven']);
          } else {
            window._paq.push(['forgetCookieConsentGiven']);
          }
        }
        window.addEventListener('CookiebotOnConsentReady', syncMatomoConsent);
        window.addEventListener('CookiebotOnAccept', syncMatomoConsent);
        window.addEventListener('CookiebotOnDecline', syncMatomoConsent);
      })();
    </script>

    <!-- Per-page head extras (preconnect hints, JSON-LD schema, etc.) -->
    <slot name="head" />
  </head>
  <body class="bg-bg text-text font-sans antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-text focus:text-bg focus:px-4 focus:py-2.5 focus:font-semibold">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      // Sitewide click + FAQ-open tracking. Matomo is now always
      // loaded (cookieless by default, full mode after Statistics
      // consent), so trackEvent calls fire for every visitor — the
      // event itself is recorded either way, just without the
      // visitor-ID linkage for non-consenters.
      import '../scripts/analytics.ts';
    </script>
  </body>
</html>
