---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
}
const {
  title = 'Cytidel',
  description,
  ogImage,
  ogType,
} = Astro.props;

// Organization JSON-LD — emitted sitewide so Google's knowledge panel
// (logo, social links, description in the right-side card on search
// results) has the data it needs.
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Cytidel',
  url: 'https://cytidel.com',
  logo: 'https://cytidel.com/img/logo_light_backgrounds.svg',
  description: 'The early warning layer for vulnerabilities, threat actors and supplier risk.',
  sameAs: ['https://www.linkedin.com/company/cytidel/'],
};
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Cookiebot consent management. Must be the first script in <head>
         so its auto-blocking can intercept tracker scripts (Matomo below)
         before they fire. CBID is the same one used on the existing
         Webflow site at cytidel.com — the new Astro domain needs to be
         added to the Cookiebot dashboard allowlist before this works in
         production. -->
    <script
      is:inline
      id="Cookiebot"
      src="https://consent.cookiebot.com/uc.js"
      data-cbid="aa407693-b2ed-4e09-886f-cac747660436"
      type="text/javascript"
    ></script>

    <SEO title={title} description={description} ogImage={ogImage} ogType={ogType} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <link rel="icon" type="image/svg+xml" href="/img/favicon.svg" />
    <meta name="theme-color" content="#f1f1ec" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Mona+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <!-- Matomo Cloud — analytics for cytidel.com. The Cookiebot script
         above auto-blocks this until the user consents to statistics. -->
    <script is:inline>
      var _paq = window._paq = window._paq || [];
      _paq.push(['trackPageView']);
      _paq.push(['enableLinkTracking']);
      (function() {
        var u = "https://cytidel.matomo.cloud/";
        _paq.push(['setTrackerUrl', u + 'matomo.php']);
        _paq.push(['setSiteId', '1']);
        var d = document, g = d.createElement('script'), s = d.getElementsByTagName('script')[0];
        g.async = true;
        g.src = 'https://cdn.matomo.cloud/cytidel.matomo.cloud/matomo.js';
        s.parentNode.insertBefore(g, s);
      })();
    </script>

    <!-- Leadfeeder Website Tracker — B2B visitor identification. Loads
         sc.lfeeder.com/lftracker_v1_<siteId>.js. Cookiebot above
         auto-blocks this until the user consents to marketing cookies,
         provided Leadfeeder is categorised as "marketing" in the
         Cookiebot dashboard (it usually is by default via the scanner).
         Site ID lives in the IIFE arg; rotate by editing here. -->
    <script is:inline>
      (function(ss,ex){
        window.ldfdr = window.ldfdr || function(){(ldfdr._q = ldfdr._q || []).push([].slice.call(arguments));};
        (function(d,s){
          var fs = d.getElementsByTagName(s)[0];
          function ce(src){
            var cs = d.createElement(s);
            cs.src = src;
            cs.async = 1;
            fs.parentNode.insertBefore(cs, fs);
          }
          ce('https://sc.lfeeder.com/lftracker_v1_' + ss + (ex ? '_' + ex : '') + '.js');
        })(document, 'script');
      })('bElvO73lK9V4ZMqj');
    </script>

    <!-- Per-page head extras (preconnect hints, JSON-LD schema, etc.) -->
    <slot name="head" />
  </head>
  <body class="bg-bg text-text font-sans antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-text focus:text-bg focus:px-4 focus:py-2.5 focus:font-semibold">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      // Sitewide click + FAQ-open tracking. No-ops until Matomo loads
      // (which only happens after Cookiebot consent).
      import '../scripts/analytics.ts';
    </script>
  </body>
</html>
